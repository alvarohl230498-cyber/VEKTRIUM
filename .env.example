# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Origen publico del sitio, usado para construir el emailRedirectTo del
# magic link (src/app/login/actions.ts) hacia /auth/callback.
NEXT_PUBLIC_SITE_URL=

# Correos de fundadores separados por coma, leidos por scripts/seed-founders.ts.
# No se hardcodea aqui ningun correo real.
FOUNDER_EMAILS=

# Postgres directo con el rol "postgres" (migraciones, seeds, src/db/admin).
# En Supabase este rol tiene BYPASSRLS: nunca debe usarlo el codigo de app/.
DATABASE_URL=

# Rol de aplicacion SIN bypassrls (ver src/db/client.ts). Crearlo una vez por
# proyecto: CREATE ROLE vektrium_app WITH LOGIN PASSWORD '...' NOSUPERUSER
# NOBYPASSRLS; GRANT authenticated TO vektrium_app; GRANT USAGE ON SCHEMA
# public TO vektrium_app; El usuario de la cadena de conexion del pooler debe
# llevar el sufijo del proyecto: vektrium_app.<referencia-del-proyecto>.
DATABASE_URL_APP=

TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/vektrium_test

# Cifrado de refresh tokens de calendario (32 bytes en base64)
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Politica de papelera
TRASH_RETENTION_DAYS=30
